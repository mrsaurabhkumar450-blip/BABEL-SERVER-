{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with language preferences and security settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "preferredLanguage": { "type": "string" },
        "updatedAt": { "type": "integer" }
      },
      "required": ["uid"]
    },
    "CommandLog": {
      "title": "CommandLog",
      "description": "Encrypted command audit log entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "integer" },
        "encCommand": { "type": "string" },
        "encResponse": { "type": "string" },
        "actionType": { "type": "string" },
        "isVoice": { "type": "boolean" }
      },
      "required": ["id", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User preferences and security profile"
    },
    "/users/{userId}/commands/{commandId}": {
      "schema": { "$ref": "#/entities/CommandLog" },
      "description": "User's encrypted command logs"
    }
  }
}
